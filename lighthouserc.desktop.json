{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/servidor.mjs",
      "startServerReadyPattern": "naptestul.pt local",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/em-breve/",
        "http://127.0.0.1:4173/privacidade/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 153600
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
